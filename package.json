{
  "name": "airdraw-lab",
  "version": "1.0.1",
  "private": true,
  "description": "灵绘：本地手势画布、星光告白与烟花",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "setup": "node scripts/setup-assets.mjs",
    "test": "node --test tests/*.test.js",
    "desktop:build": "npm run setup && npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:smoke": "npm run desktop:build && electron . --smoke-test --smoke-result=smoke-result.json",
    "dist:win": "npm run desktop:build && electron-builder --config electron-builder.json --win portable --x64 --publish never && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/release-version.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@mediapipe/tasks-vision": "0.10.32",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "vite": "7.1.7"
  }
}
